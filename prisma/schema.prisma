generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (managed by OxfordHub) ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(USER)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  SUSPENDED
}

// ─── Gmail ────────────────────────────────────────────────────────────────────

model GmailAccount {
  id           String    @id @default(cuid())
  email        String    @unique
  accessToken  String    @db.Text
  refreshToken String    @db.Text
  tokenExpiry  DateTime?
  historyId    String?
  lastSyncAt   DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── Publishers ───────────────────────────────────────────────────────────────

enum PublisherType {
  INTERNAL // your own company
  COMPETITOR // direct competitor
  AFFILIATE_MARKETER // third-party affiliate
  UNKNOWN // domain seen but publisher not yet identified
}

model Publisher {
  id                 String        @id @default(cuid())
  name               String        @unique
  type               PublisherType @default(COMPETITOR)
  domains            String[]
  knownFromAddresses String[]
  website            String?
  notes              String?
  isConfirmed        Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  lists            List[]
  learnings        Learning[]
  emails           Email[]
  gurus            Guru[]
  secondaryGurus   GuruSecondaryPublisher[]
  promoAdvertisers PromoAdvertiser[]
  promoSightings   PromoSighting[]
}

// ─── Lists (newsletters) ──────────────────────────────────────────────────────

enum ListCategory {
  FREE_EDITORIAL
  PAID_EDITORIAL
  HOTLIST
  MARKETING_FILE
}

model List {
  id               String       @id @default(cuid())
  name             String       @unique
  category         ListCategory @default(FREE_EDITORIAL)
  publisherId      String?
  publisher        Publisher?   @relation(fields: [publisherId], references: [id])
  notes            String?
  // Internal pub codes — link an iSpy list to internal MTA email lists (for MTATRIX).
  // Most lists won't have these; they're only for our own lists, not competitors'.
  editorialPubCode String? // editorial sends (T-Letters, articles)
  dedicatedPubCode String? // promos / lift notes
  synonyms         String[]
  isIgnored        Boolean      @default(false)
  autoCreated      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  gurus          GuruList[]
  learnings      Learning[]
  emails         Email[]
  promoSightings PromoSighting[]
}

// ─── Gurus (editors/voices) ───────────────────────────────────────────────────

model Guru {
  id               String     @id @default(cuid())
  name             String     @unique
  notes            String?
  isIgnored        Boolean    @default(false)
  isSecondaryVoice Boolean    @default(false)
  publisherId      String?
  publisher        Publisher? @relation(fields: [publisherId], references: [id])
  createdAt        DateTime   @default(now())

  lists               GuruList[]
  emails              EmailGuru[]
  learnings           Learning[]
  // Secondary voice relationships
  primaryGurus        SecondaryVoiceGuru[]     @relation("SecondaryVoice")
  secondaryVoices     SecondaryVoiceGuru[]     @relation("PrimaryGuru")
  // Additional publishers this guru writes for (MANUALLY set only — never auto-detected)
  secondaryPublishers GuruSecondaryPublisher[]
}

// Additional publishers a guru is published by, beyond their primary `publisherId`.
// Set ONLY by manual user action — the email analyzer must never write here. A guru
// is a legitimate MEMBER of a list whose publisher is his primary OR any of these.
model GuruSecondaryPublisher {
  guruId      String
  publisherId String
  guru        Guru      @relation(fields: [guruId], references: [id], onDelete: Cascade)
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([guruId, publisherId])
}

// Links a secondary voice to the primary guru(s) they support
model SecondaryVoiceGuru {
  secondaryVoiceId String
  primaryGuruId    String
  secondaryVoice   Guru   @relation("SecondaryVoice", fields: [secondaryVoiceId], references: [id], onDelete: Cascade)
  primaryGuru      Guru   @relation("PrimaryGuru", fields: [primaryGuruId], references: [id], onDelete: Cascade)

  @@id([secondaryVoiceId, primaryGuruId])
}

model GuruList {
  guruId    String
  listId    String
  isPrimary Boolean @default(false)
  isIgnored Boolean @default(false) // true = AI learned this guru is NOT on this list
  guru      Guru    @relation(fields: [guruId], references: [id], onDelete: Cascade)
  list      List    @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([guruId, listId])
}

// ─── Emails ───────────────────────────────────────────────────────────────────

model Email {
  id                 String     @id @default(cuid())
  gmailMessageId     String     @unique
  subject            String
  fromName           String?
  fromEmail          String
  toEmail            String?
  receivedAt         DateTime
  bodyHtml           String?    @db.Text
  bodyText           String?    @db.Text
  snippet            String?
  inboxPlacement     Placement  @default(UNKNOWN)
  publisherId        String?
  publisher          Publisher? @relation(fields: [publisherId], references: [id])
  publisherConfirmed Boolean    @default(false)
  listId             String?
  list               List?      @relation(fields: [listId], references: [id])
  listConfirmed      Boolean    @default(false)
  emailType          EmailType  @default(UNKNOWN)
  emailTypeConfirmed Boolean    @default(false)
  aiSummary          String?    @db.Text
  aiTicker           String?
  aiConfidence       Float?
  isProcessed        Boolean    @default(false)
  syncedAt           DateTime   @default(now())
  createdAt          DateTime   @default(now())

  topics         EmailTopic[]
  tags           EmailTag[]
  gurus          EmailGuru[]
  offer          Offer?
  learnings      Learning[]
  deepAnalysis   EmailAnalysis?
  promoSightings PromoSighting[]

  @@index([receivedAt])
  @@index([fromEmail])
  @@index([publisherId])
  @@index([listId])
  @@index([inboxPlacement])
  @@index([emailType])
}

model EmailGuru {
  emailId String
  guruId  String
  email   Email  @relation(fields: [emailId], references: [id], onDelete: Cascade)
  guru    Guru   @relation(fields: [guruId], references: [id], onDelete: Cascade)

  @@id([emailId, guruId])
}

enum Placement {
  PRIMARY
  PROMOTIONS
  SPAM
  UPDATES
  SOCIAL
  UNKNOWN
}

enum EmailType {
  LIFT_NOTE
  EDITORIAL
  PROMO
  WELCOME
  UNKNOWN
}

// ─── Topics ───────────────────────────────────────────────────────────────────

model Topic {
  id          String       @id @default(cuid())
  name        String       @unique
  isIgnored   Boolean      @default(false)
  // Secondary = granular / less-significant detail topic. Kept out of Hot Topics
  // and the trend chart; still tracked and filterable. New AI-coined topics
  // default to secondary so the primary set stays curated.
  isSecondary Boolean      @default(false)
  color       String?
  synonyms    String[]
  createdAt   DateTime     @default(now())
  emails      EmailTopic[]
}

model EmailTopic {
  emailId    String
  topicId    String
  confidence Float  @default(1.0)
  email      Email  @relation(fields: [emailId], references: [id], onDelete: Cascade)
  topic      Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([emailId, topicId])
}

// ─── Tags ─────────────────────────────────────────────────────────────────────

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("#6B7280")
  createdAt DateTime   @default(now())
  emails    EmailTag[]
}

model EmailTag {
  emailId String
  tagId   String
  email   Email  @relation(fields: [emailId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([emailId, tagId])
}

// ─── Offers ───────────────────────────────────────────────────────────────────

// ─── Intelligence / Learnings ─────────────────────────────────────────────────

enum LearningSource {
  AI_EMAIL // extracted from email content by Claude
  USER_ACTION // logged when user merges, ignores, edits
}

enum LearningStatus {
  PENDING
  VALIDATED
  IGNORED
}

enum LearningCategory {
  GURU
  PUBLISHER
  LIST
  TOPIC
  GENERAL
}

model Learning {
  id                String           @id @default(cuid())
  content           String           @db.Text
  source            LearningSource
  category          LearningCategory @default(GENERAL)
  status            LearningStatus   @default(PENDING)
  isContradicted    Boolean          @default(false) // flags when this contradicts validated knowledge
  contradictionNote String?          @db.Text // explains which validated fact this conflicts with
  appendedToBrain   Boolean          @default(false) // true once pushed to brain vault
  appendedAt        DateTime?
  emailId           String?
  email             Email?           @relation(fields: [emailId], references: [id], onDelete: SetNull)
  guruId            String?
  guru              Guru?            @relation(fields: [guruId], references: [id], onDelete: SetNull)
  publisherId       String?
  publisher         Publisher?       @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  listId            String?
  list              List?            @relation(fields: [listId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
}

model Offer {
  id      String  @id @default(cuid())
  emailId String  @unique
  url     String?
  promise String? @db.Text
  ticker  String?
  email   Email   @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

// ─── Deep Analysis (Pass 2 — Sonnet) ─────────────────────────────────────────

model EmailAnalysis {
  id             String   @id @default(cuid())
  emailId        String   @unique
  email          Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  analysisType   String // PROMO | LIFT_NOTE | EDITORIAL
  rawJson        Json
  complianceRisk String   @default("NONE") // HIGH | MEDIUM | LOW | NONE
  mtaOverlap     String   @default("LOW") // HIGH | MEDIUM | LOW
  notableFor     String? // COPY | EDITORIAL | COMPLIANCE | PRODUCT | ALL
  modelUsed      String   @default("claude-sonnet-4-5")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Promo tracking ───────────────────────────────────────────────────────────
// Emails carry per-recipient tracking links, not promo URLs. lib/promo-links.ts
// resolves those to the real landing page; these tables are the running record
// of which promo each publisher put in front of the industry, on which day.

/// The company whose promo a landing page belongs to — which is NOT the mailer
/// when the send came through an affiliate file like MarketBeat.
model PromoAdvertiser {
  id             String     @id @default(cuid())
  domain         String     @unique // registrable domain of the landing page
  label          String // display name; auto-derived, human-editable
  labelConfirmed Boolean    @default(false)
  /// The domain hosts other people's funnels (Zoom, Infusionsoft, a webinar
  /// platform), so it names the tooling and never the advertiser.
  isPlatform     Boolean    @default(false)
  publisherId    String?
  publisher      Publisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  isInternal     Boolean    @default(false) // an Oxford Group / MTA property
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  promos Promo[]
}

model Promo {
  id           String @id @default(cuid())
  canonicalKey String @unique // host + normalised path + identifying query
  landingUrl   String @db.Text
  landingHost  String

  advertiserId String
  advertiser   PromoAdvertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  headline       String? @db.Text
  headlineSource String? // PAGE_H1 | PAGE_OG | PAGE_TITLE | SUBJECT | MANUAL
  lastStatus     Int? // HTTP status of the last resolution (403 = Cloudflare-gated)

  /// VSL | LEAD_GEN | EQUITY_RAISE — EQUITY_RAISE is a startup raise bought on a
  /// finpub list (Doroni, Kara Water), not a competitor's offer.
  kind            String  @default("VSL")
  /// Per-promo advertiser, for platform-hosted pages whose domain names no one.
  /// Overrides the advertiser label for this promo only.
  advertiserLabel String?

  firstSeenOn  DateTime @db.Date
  lastSeenOn   DateTime @db.Date
  daysDetected Int      @default(1)

  // VidRipper → transcript → promo-analyzer handoff
  vidripperJobId  String?
  vidripperStatus String? // requested | ripping | transcribing | analyzing | done | error
  vidripperError  String?   @db.Text
  promoReviewId   String?
  ripRequestedAt  DateTime?
  ripRequestedBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sightings PromoSighting[]

  @@index([lastSeenOn])
  @@index([advertiserId])
  @@index([kind])
}

/// One promo appearing in one email. The feed is built from these, so a promo
/// mailed on five days shows up on five days.
model PromoSighting {
  id      String @id @default(cuid())
  promoId String
  promo   Promo  @relation(fields: [promoId], references: [id], onDelete: Cascade)
  emailId String
  email   Email  @relation(fields: [emailId], references: [id], onDelete: Cascade)

  day         DateTime   @db.Date // ET calendar day the email landed
  publisherId String? // the mailer
  publisher   Publisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  listId      String?
  list        List?      @relation(fields: [listId], references: [id], onDelete: SetNull)
  subject     String     @db.Text
  rawUrl      String     @db.Text // the tracking link as it appeared in the email
  isFirstEver Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@unique([promoId, emailId])
  @@index([day])
  @@index([publisherId])
  @@index([listId])
}

/// One row per scheduled job per day — makes the wall-clock scheduler idempotent
/// across restarts and holds the digest we built.
model PromoJobRun {
  id            String    @id @default(cuid())
  kind          String // SCAN | DIGEST
  day           DateTime  @db.Date
  status        String // RUNNING | OK | ERROR
  emailsScanned Int       @default(0)
  promosFound   Int       @default(0)
  newPromos     Int       @default(0)
  digestText    String?   @db.Text
  slackTs       String?
  error         String?   @db.Text
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@unique([kind, day])
}
